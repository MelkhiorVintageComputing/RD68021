`verilator_config

// Waivers for RD68021. Every one has a reason; see doc/coding-standard.md.
//
// Two file-format traps, both measured: the line above must be the first token in
// this file, and no comment here may start with the word that names this tool --
// it parses those as directives and reports a syntax error. Globs are matched
// against the path as given on the command line, so *rtl/foo.sv matches and
// */rtl/foo.sv does not.

// rd68021_pkg is a catalogue of architectural constants transcribed from the
// manual. No single module uses all of them, and the point of the package is that
// the numbers are written down once, in one place, with their citation -- so an
// unused one is the normal case rather than a defect.
lint_off -rule UNUSEDPARAM -file "*rtl/rd68021_pkg.sv"
